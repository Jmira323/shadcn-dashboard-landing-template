# Supabase project credentials (Supabase dashboard -> Settings -> API)
# Copy this file to .env.local and fill in the values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional, local-only: secret (service role) key for admin scripts such as
# seeding the demo user. Server-side only — never expose with a NEXT_PUBLIC_
# prefix and never commit it.
# SUPABASE_SECRET_KEY=your-secret-key

# Optional: PostHog analytics (posthog.com -> project settings). Analytics are
# disabled in production when either key is unset.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your-project-api-key
NEXT_PUBLIC_POSTHOG_HOST=https://your-posthog-host
